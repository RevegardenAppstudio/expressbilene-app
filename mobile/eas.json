{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "sideload": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SIDELOAD": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817419428"
      }
    }
  }
}
